@inherits LayoutComponentBase

<MudThemeProvider Theme="@_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout>
    <MudAppBar Elevation="0" Style="border-bottom: 1px solid var(--mud-palette-lines-default); backdrop-filter: blur(12px);">
        <MudIcon Icon="@Icons.Material.Filled.Bolt" Color="Color.Primary" Class="mr-2" />
        <MudText Typo="Typo.h6" Class="ml-1" Style="font-weight: 700; letter-spacing: -0.5px;">
            Mijn Migraine
        </MudText>
        <MudSpacer />
        <MudTooltip Text="@(_isDarkMode ? "Schakel naar lichte modus" : "Schakel naar donkere modus")">
            <MudIconButton Icon="@(DarkLightModeButtonIcon)" Color="Color.Inherit" Edge="Edge.End" OnClick="@DarkModeToggle" />
        </MudTooltip>
    </MudAppBar>
    <MudMainContent Class="mt-16 pa-4">
        <MudContainer MaxWidth="MaxWidth.Large">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>


<div id="blazor-error-ui">
    Er is een onverwachte fout opgetreden.
    <a href="" class="reload">Herladen</a>
    <a class="dismiss">🗙</a>
</div>

@code 
{
    private bool _isDarkMode = true;
    private MudTheme? _theme = null;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        _theme = new()
        {
            PaletteLight = _lightPalette,
            PaletteDark = _darkPalette,
            LayoutProperties = new LayoutProperties(),
            Typography = new Typography
            {
                Default = new DefaultTypography
                {
                    FontFamily = ["'Inter'", "Roboto", "Helvetica", "Arial", "sans-serif"]
                }
            }
        };
    }

    private void DarkModeToggle()
    {
        _isDarkMode = !_isDarkMode;
    }

    private readonly PaletteLight _lightPalette = new()
    {
        Black = "#110e2d",
        Primary = "#6C5CE7",
        PrimaryDarken = "#5A4BD5",
        PrimaryLighten = "#A29BFE",
        Secondary = "#636e72",
        AppbarText = "#2d3436",
        AppbarBackground = "rgba(255,255,255,0.85)",
        Background = "#f8f9fa",
        Surface = "#ffffff",
        DrawerBackground = "#ffffff",
        GrayLight = "#e8e8e8",
        GrayLighter = "#f9f9f9",
        LinesDefault = "#e2e8f0",
        TableLines = "#e2e8f0",
        Divider = "#e2e8f0",
    };

    private readonly PaletteDark _darkPalette = new()
    {
        Primary = "#A29BFE",
        PrimaryDarken = "#6C5CE7",
        PrimaryLighten = "#D4D0FF",
        Secondary = "#a0aec0",
        Surface = "#1e1e2e",
        Background = "#141420",
        BackgroundGray = "#12121c",
        AppbarText = "#a0aec0",
        AppbarBackground = "rgba(20,20,32,0.85)",
        DrawerBackground = "#1a1a27",
        ActionDefault = "#74718e",
        ActionDisabled = "#9999994d",
        ActionDisabledBackground = "#605f6d4d",
        TextPrimary = "#cdd6f4",
        TextSecondary = "#a0aec0",
        TextDisabled = "#ffffff33",
        DrawerIcon = "#a0aec0",
        DrawerText = "#a0aec0",
        GrayLight = "#2a2833",
        GrayLighter = "#1e1e2d",
        Info = "#74b9ff",
        Success = "#55efc4",
        Warning = "#ffeaa7",
        Error = "#ff7675",
        LinesDefault = "#2d2d44",
        TableLines = "#2d2d44",
        Divider = "#2d2d44",
        OverlayLight = "#1e1e2d80",
    };

    public string DarkLightModeButtonIcon => _isDarkMode switch
    {
        true => Icons.Material.Rounded.LightMode,
        false => Icons.Material.Outlined.DarkMode,
    };
}